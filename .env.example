APP_HTTP_PORT=8080
APP_METRICS_PORT=9090
APP_REPLICAS=3

POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=local-postgres-admin-secret
POSTGRES_HOST_PORT=5432

COMPOSE_PROJECT_NAME=wager-service

LOCALSTACK_HOST_PORT=4566

AWS_REGION=us-east-1
AWS_ACCOUNT_ID=000000000000
APP_DATABASE_MIGRATION_USER=wager_migration
APP_DATABASE_MIGRATION_PASSWORD=local-wager-migration-secret
APP_DATABASE_USER=wager_app
APP_DATABASE_PASSWORD=local-wager-database-secret
APP_DATABASE_NAME=wager
COMPONENTS=http,sqs-consumer,outbox,pending-reference
SHUTDOWN_TIMEOUT=30s

KEYCLOAK_DATABASE_USER=keycloak
KEYCLOAK_DATABASE_PASSWORD=local-keycloak-database-secret
KEYCLOAK_DATABASE_NAME=keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-admin-secret
KEYCLOAK_HOST_PORT=8081
KEYCLOAK_PUBLIC_URL=http://keycloak.localhost:8081
OIDC_ISSUER_URL=http://keycloak.localhost:8081/realms/wager
OIDC_AUDIENCE=backend-api
PROVIDER_A_CLIENT_SECRET=local-provider-a-secret
PROVIDER_B_CLIENT_SECRET=local-provider-b-secret
INTERNAL_SERVICE_CLIENT_SECRET=local-internal-service-secret

MINISTACK_IMAGE=ministackorg/ministack:1.5.26@sha256:f90981c85c9b431d819afa8bdad9735d1434e22e42f1deb8c99a0bcaf30363e7

SQS_INPUT_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_OUTPUT_QUEUE_NAME=wager-events.fifo
SQS_VISIBILITY_TIMEOUT=60
SQS_WAIT_TIME_SECONDS=20
SQS_REDRIVE_MAX_RECEIVE_COUNT=5
